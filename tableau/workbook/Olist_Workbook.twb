    <worksheet name='Distribution of Seller Late Rates'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Shrunk late rates pull seller estimates toward the overall average, reducing noise from sellers with fewer orders.</run>
