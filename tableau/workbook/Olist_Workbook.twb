    <dashboard enable-sort-zone-taborder='true' name='The cliff'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='91750' id='14' param='vert' type-v2='layout-flow' w='98666' x='667' y='1000'>
            <zone h='5250' id='15' type-v2='title' w='98666' x='667' y='1000'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='86500' id='12' param='vert' type-v2='layout-flow' w='98666' x='667' y='6250'>
              <zone h='86500' id='7' param='horz' type-v2='layout-flow' w='98666' x='667' y='6250'>
                <zone h='86500' id='1' param='vert' type-v2='layout-flow' w='98666' x='667' y='6250'>
                  <zone h='41937' id='3' name='Delivery Gap (Overall)' w='98666' x='667' y='6250'>
                    <layout-cache minheight='203' type-h='scalable' type-w='cell' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='2875' id='16' type-v2='text' w='98666' x='667' y='48187'>
                    <formatted-text>
                      <run fontcolor='#000000' fontname='-webkit-standard'>Customers barely reward early delivery (about 0.3 stars across the whole early range) but heavily punish late delivery (about 2.4 stars).</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='41687' id='4' param='horz' type-v2='layout-flow' w='98666' x='667' y='51062'>
                    <zone fixed-size='569' h='41687' id='5' is-fixed='true' name='Delivery Gap (Review Timing)' w='48084' x='667' y='51062'>
                      <layout-cache minheight='201' type-h='scalable' type-w='cell' />
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='4' />
                      </zone-style>
                    </zone>
                    <zone h='41687' id='10' name='Review Timing Distribution' w='50578' x='48751' y='51062'>
                      <layout-cache cell-count-w='6' minheight='201' non-cell-size-w='66' type-h='scalable' type-w='cell' />
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='4' />
                      </zone-style>
                    </zone>
                  </zone>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone h='6250' id='20' is-fixed='true' type-v2='layout-basic' w='98666' x='667' y='92750'>
            <zone h='6250' id='17' param='horz' type-v2='layout-flow' w='54750' x='667' y='92750'>
              <zone h='6250' id='18' type-v2='text' w='54750' x='667' y='92750'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='Benton Sans Book'>Cells with fewer than about 100 reviews are noisy. Interpret the late-side averages for these small groups with caution.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone h='6250' id='21' param='horz' type-v2='layout-flow' w='43916' x='55417' y='92750'>
              <zone forceUpdate='true' h='6250' id='19' type-v2='text' w='43916' x='55417' y='92750'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='-webkit-standard'>Customers who answered before delivery were reacting to a broken promise, not to measured lateness. This makes the pre-delivery cohort a different population, so treat the late-side curve with care. Observational, not causal</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{FD98F6BA-AF32-4226-B4DE-D8516FFD685C}' />
    </dashboard>
    <dashboard enable-sort-zone-taborder='true' name='Where and When'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' preset-index='17' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='67125' id='11' param='horz' type-v2='layout-flow' w='98666' x='667' y='1000'>
            <zone h='67125' id='5' param='vert' type-v2='layout-flow' w='98666' x='667' y='1000'>
              <zone h='5250' id='7' type-v2='title' w='98666' x='667' y='1000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='37' forceUpdate='true' h='5625' id='22' is-fixed='true' type-v2='text' w='98666' x='667' y='6250'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='Benton Sans Book'>Late delivery varies substantially across states and over time. Higher-lateness states include several states in the Northeast/Northeast-adjacent region, while RJ shows particularly strong spikes during late 2017 and early 2018. The monthly pattern indicates broader regional increases during these periods.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='7000' id='23' type-v2='text' w='98666' x='667' y='11875'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>State patterns:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> AL, MA and SE have among the highest late-delivery rates.
</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Timing:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> Late-delivery rates rise sharply during several periods in late 2017 and early 2018.
</run>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Context:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'> State averages reflect both actual delivery speed and promised delivery windows.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
